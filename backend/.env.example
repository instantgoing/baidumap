# 百度地图服务端应用 AK；不要使用浏览器端 AK
BAIDU_SERVICE_AK=
BAIDU_BASE_URL=https://api.map.baidu.com
BAIDU_TIMEOUT_SECONDS=12
BAIDU_RETRY_COUNT=1

# Web Service 可靠性与配额保护
BAIDU_MAX_CONCURRENCY=2
BAIDU_MAX_QPS=1
BAIDU_QPS_WINDOW_SECONDS=3.2
BAIDU_CACHE_TTL_SECONDS=300
BAIDU_CACHE_MAX_ENTRIES=256
BAIDU_CIRCUIT_FAILURE_THRESHOLD=4
BAIDU_CIRCUIT_COOLDOWN_SECONDS=20
MAX_ROUTE_DESTINATIONS=50

CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
