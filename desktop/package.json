{
  "name": "baidumap-desktop",
  "version": "0.6.0",
  "private": true,
  "description": "Windows desktop wrapper for the Neighborhood Radius Baidu Map application",
  "main": "main.cjs",
  "author": "Neighborhood Radius contributors",
  "license": "MulanPSL-2.0",
  "scripts": {
    "build:web": "powershell -NoProfile -ExecutionPolicy Bypass -File build/build-web.ps1",
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "smoke:backend": "node scripts/smoke-backend.cjs",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --dir --config electron-builder.yml",
    "dist": "electron-builder --win nsis --x64 --config electron-builder.yml --publish never"
  },
  "devDependencies": {
    "electron": "44.4.0",
    "electron-builder": "26.15.3"
  }
}
